APP_MODE=development

# Discord bot token
DISCORD_TOKEN=your-discord-bot-token

# Canvas API token
CANVAS_TOKEN=your-canvas-api-token

# Canvas base URLs (no trailing slash)
CANVAS_BASE_URL_DEV=https://your-school.beta.instructure.com
CANVAS_BASE_URL_PROD=https://your-school.instructure.com

# Discord user ID to ping on rotation failures
ADMIN_DISCORD_ID=123456789012345678

# Optional overrides
# DB_URL=sqlite:////data/quizbot.db
# CODE_LENGTH=6
# ONESHOT_LATE_GUARD_HOURS=24
